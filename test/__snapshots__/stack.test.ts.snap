    "SettingsComposeParameterFE954861": {
      "Properties": {
        "Description": "docker compose file for the Valheim server",
        "Type": "String",
        "Value": "services:
  valheim:
    image: ghcr.io/community-valheim-tools/valheim-server:1.3.0
    container_name: valheim
    cap_add:
      - sys_nice
    stop_grace_period: 2m
    restart: unless-stopped
    ports:
      - 2456-2457:2456-2457/udp
    env_file:
      - /opt/valheim/.env
    environment:
      SERVER_NAME: valheim-osrs-nerds
      WORLD_NAME: OsrsNerds
      SERVER_PUBLIC: "true"
      SERVER_ARGS: -saveinterval 900 -modifier deathpenalty veryeasy -modifier combat
        veryhard -modifier raids more
      ADMINLIST_IDS: "76561198097010635"
      PUID: "1000"
      PGID: "1000"
      TZ: America/Toronto
      UPDATE_CRON: 0 * * * *
      UPDATE_IF_IDLE: "true"
      RESTART_CRON: 10 5 * * *
      BACKUPS: "true"
      BACKUPS_CRON: 5 * * * *
      BACKUPS_MAX_COUNT: "48"
      BACKUPS_MAX_AGE: "3"
      POST_SERVER_LISTENING_HOOK: "curl -sfSL -X POST -H 'Content-Type:
        application/json' -d '{\\"content\\":\\"Valheim OsrsNerds is up\\"}'
        \\"$$DISCORD_WEBHOOK\\""
      PRE_SERVER_SHUTDOWN_HOOK: "curl -sfSL -X POST -H 'Content-Type:
        application/json' -d '{\\"content\\":\\"Valheim OsrsNerds is shutting
        down\\"}' \\"$$DISCORD_WEBHOOK\\""
      BEPINEX: "true"
    volumes:
      - /opt/valheim/config:/config
      - /opt/valheim/data:/opt/valheim
  valheim-rpgworld:
    image: ghcr.io/community-valheim-tools/valheim-server:1.3.0
    container_name: valheim-rpgworld
    cap_add:
      - sys_nice
    stop_grace_period: 2m
    restart: unless-stopped
    ports:
      - 2460-2461:2456-2457/udp
    env_file:
      - /opt/valheim/.env
    environment:
      SERVER_NAME: valheim-osrs-nerds - RPGWorld
      WORLD_NAME: RPGWorld
      SERVER_PUBLIC: "true"
      SERVER_ARGS: -saveinterval 900 -modifier deathpenalty veryeasy -modifier raids none
      ADMINLIST_IDS: "76561198097010635"
      PUID: "1000"
      PGID: "1000"
      TZ: America/Toronto
      UPDATE_CRON: 0 * * * *
      UPDATE_IF_IDLE: "true"
      RESTART_CRON: 10 5 * * *
      BACKUPS: "true"
      BACKUPS_CRON: 5 * * * *
      BACKUPS_MAX_COUNT: "48"
      BACKUPS_MAX_AGE: "3"
      POST_SERVER_LISTENING_HOOK: "curl -sfSL -X POST -H 'Content-Type:
        application/json' -d '{\\"content\\":\\"Valheim RPGWorld is up\\"}'
        \\"$$DISCORD_WEBHOOK\\""
      PRE_SERVER_SHUTDOWN_HOOK: "curl -sfSL -X POST -H 'Content-Type:
        application/json' -d '{\\"content\\":\\"Valheim RPGWorld is shutting
        down\\"}' \\"$$DISCORD_WEBHOOK\\""
      BEPINEX: "true"
    volumes:
      - /opt/valheim/worlds/rpgworld/config:/config
      - /opt/valheim/worlds/rpgworld/data:/opt/valheim
",
      },
      "Type": "AWS::SSM::Parameter",
    },
    "SettingsModConfigJuneGameValheimForsakenPowerOverhaulcfgD5AEC8F4": {
      "Properties": {
        "Description": "BepInEx config override JuneGame.Valheim.ForsakenPowerOverhaul.cfg",
        "Name": "/valheim/mods/config/JuneGame.Valheim.ForsakenPowerOverhaul.cfg",
        "Type": "String",
        "Value": "# Vanilla+ preset copied into Custom so one line can change: the Elder's equipped bonus covers pickaxes as well as woodcutting.
[S00 Server: General]
Preset = Custom
PowerActiveDuration = 300
PowerCooldownDuration = 420
[S11 Server: Eikthyr (Passive)]
MaxStamina = 25
EquipmentSpeedModifier = 50
[S12 Server: Eikthyr (Equipped)]
StaminaRegenModifier = 100
