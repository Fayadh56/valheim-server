    "SettingsModsParameter9E87135C": {
      "Properties": {
        "Description": "Thunderstore packages the Valheim server installs at every start",
        "Name": "/valheim/mods/packages",
        "Type": "String",
        "Value": "[{"namespace":"ValheimModding","name":"Jotunn","version":"2.30.2"},{"namespace":"MidnightMods","name":"NetworkPerformanceSystem","version":"1.13.0"},{"namespace":"MidnightMods","name":"ValheimCommunityPatch","version":"0.32.1"},{"namespace":"OSRSNerds","name":"ForsakenPowerOverhaul_FaderFix","version":"2.2.1"},{"namespace":"xtavim","name":"BetterConsumables","version":"1.1.0"},{"namespace":"sighsorry","name":"InventorySlots","version":"1.5.17"},{"namespace":"ASharpPen","name":"Drop_That","version":"3.1.6"},{"namespace":"Hex_Viking","name":"NowYouSleep","version":"1.0.3","serverOnly":true},{"namespace":"JereKuusela","name":"Server_devcommands","version":"1.115.0","serverOnly":true}]",
      },
      "Type": "AWS::SSM::Parameter",
    },
    "SettingsProfileCodeParameterDCB88C9F": {
      "Properties": {
        "Description": "r2modman profile code shown on the panel, written by npm run share-profile",
        "Name": "/valheim/panel/profile-code",
        "Type": "String",
        "Value": "none",
      },
      "Type": "AWS::SSM::Parameter",
    },
    "SettingsProfileMessageParameter85230411": {
      "Properties": {
        "Description": "Discord message id of the pinned join post, written by npm run share-profile",
        "Name": "/valheim/panel/profile-message",
        "Type": "String",
        "Value": "none",
      },
      "Type": "AWS::SSM::Parameter",
    },
    "SettingsSecretF2BF6B26": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "Description": "Valheim server password and optional Discord webhook",
        "GenerateSecretString": {
          "ExcludePunctuation": true,
          "GenerateStringKey": "password",
          "IncludeSpace": false,
          "PasswordLength": 12,
          "SecretStringTemplate": "{"discordWebhook":""}",
        },
      },
      "Type": "AWS::SecretsManager::Secret",
      "UpdateReplacePolicy": "Delete",
    },
    "TransfersBucket5F697928": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256",
              },
            },
          ],
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "ExpirationInDays": 7,
              "Status": "Enabled",
            },
          ],
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true,
        },
      },
      "Type": "AWS::S3::Bucket",
      "UpdateReplacePolicy": "Delete",
    },
    "TransfersBucketPolicy7BB7DFF5": {
      "Properties": {
        "Bucket": {
          "Ref": "TransfersBucket5F697928",
        },
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "s3:*",
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false",
                },
              },
              "Effect": "Deny",
              "Principal": {
                "AWS": "*",
              },
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "TransfersBucket5F697928",
                    "Arn",
                  ],
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::GetAtt": [
                          "TransfersBucket5F697928",
                          "Arn",
                        ],
                      },
                      "/*",
                    ],
                  ],
                },
              ],
            },
          ],
          "Version": "2012-10-17",
        },
      },
      "Type": "AWS::S3::BucketPolicy",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
`;
