        },
        "ImageId": "dummy-value-for-/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id",
        "InstanceType": "m7a.large",
        "MetadataOptions": {
          "HttpPutResponseHopLimit": 1,
          "HttpTokens": "required",
