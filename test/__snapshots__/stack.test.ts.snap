    "SettingsModsParameter9E87135C": {
      "Properties": {
        "Description": "Thunderstore packages the Valheim server installs at every start",
        "Name": "/valheim/mods/packages",
        "Type": "String",
        "Value": "[{"namespace":"ValheimModding","name":"Jotunn","version":"2.30.2"},{"namespace":"MidnightMods","name":"NetworkPerformanceSystem","version":"1.9.0"},{"namespace":"MidnightMods","name":"ValheimCommunityPatch","version":"0.29.0"},{"namespace":"momos3939","name":"ForsakenPowerOverhaul","version":"2.2.0"},{"namespace":"xtavim","name":"BetterConsumables","version":"1.1.0"},{"namespace":"sighsorry","name":"InventorySlots","version":"1.5.13"},{"namespace":"ASharpPen","name":"Drop_That","version":"3.1.6"},{"namespace":"Hex_Viking","name":"NowYouSleep","version":"1.0.3","serverOnly":true}]",
      },
      "Type": "AWS::SSM::Parameter",
    },
    "SettingsProfileCodeParameterDCB88C9F": {
      "Properties": {
        "Description": "r2modman profile code shown on the panel, written by npm run share-profile",
        "Name": "/valheim/panel/profile-code",
        "Type": "String",
        "Value": "none",
      },
      "Type": "AWS::SSM::Parameter",
    },
    "SettingsSecretF2BF6B26": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "Description": "Valheim server password and optional Discord webhook",
        "GenerateSecretString": {
          "ExcludePunctuation": true,
          "GenerateStringKey": "password",
          "IncludeSpace": false,
          "PasswordLength": 12,
          "SecretStringTemplate": "{"discordWebhook":""}",
        },
      },
      "Type": "AWS::SecretsManager::Secret",
      "UpdateReplacePolicy": "Delete",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
