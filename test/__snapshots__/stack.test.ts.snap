        "UserData": {
          "Fn::Base64": {
            "Fn::Join": [
              "",
              [
                "#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

# The Elastic IP attaches a few seconds after boot; wait for outbound network.
for _ in $(seq 1 60); do
  curl -fsS --max-time 5 https://awscli.amazonaws.com/ >/dev/null 2>&1 && break
  sleep 5
done

apt-get update -y
apt-get install -y ca-certificates curl unzip jq

curl -fsSL https://awscli.amazonaws.com/v2/install.sh | bash -s -- --system

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
cat > /etc/apt/sources.list.d/docker.sources <<'EOF'
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: noble
Components: stable
Architectures: amd64
Signed-By: /etc/apt/keyrings/docker.asc
EOF
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
cat > /etc/docker/daemon.json <<'EOF'
{ "log-driver": "json-file", "log-opts": { "max-size": "50m", "max-file": "3" } }
EOF
systemctl enable docker
systemctl restart docker

VOLUME_ID="",
                {
                  "Ref": "ServerDataVolume3EEC0930",
                },
                ""
DEVICE="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_\${VOLUME_ID//-/}"
for _ in $(seq 1 60); do [ -e "$DEVICE" ] && break; sleep 2; done
[ -e "$DEVICE" ] || { echo "data volume $DEVICE not found"; exit 1; }
if ! blkid "$DEVICE" >/dev/null 2>&1; then
  mkfs.ext4 -L valheim "$DEVICE"
fi
mkdir -p /opt/valheim
grep -q 'LABEL=valheim' /etc/fstab || echo 'LABEL=valheim /opt/valheim ext4 defaults,nofail 0 2' >> /etc/fstab
mount -a
mkdir -p /opt/valheim/config /opt/valheim/data
chown -R 1000:1000 /opt/valheim/config /opt/valheim/data

cat > /usr/local/bin/valheim-fetch-config <<'EOF'
#!/bin/bash
set -euo pipefail
REGION="us-east-1"
PARAM="",
                {
                  "Ref": "SettingsComposeParameterFE954861",
                },
                ""
SECRET="",
                {
                  "Ref": "SettingsSecretF2BF6B26",
                },
                ""
aws ssm get-parameter --region "$REGION" --name "$PARAM" --query Parameter.Value --output text > /opt/valheim/compose.yaml.tmp
mv /opt/valheim/compose.yaml.tmp /opt/valheim/compose.yaml
SECRET_JSON="$(aws secretsmanager get-secret-value --region "$REGION" --secret-id "$SECRET" --query SecretString --output text)"
umask 077
printf 'SERVER_PASS=%s\\nDISCORD_WEBHOOK=%s\\n' \\
  "$(jq -r .password <<<"$SECRET_JSON")" \\
  "$(jq -r .discordWebhook <<<"$SECRET_JSON")" > /opt/valheim/.env.tmp
mv /opt/valheim/.env.tmp /opt/valheim/.env
umask 022
aws ssm get-parameter --region "$REGION" --name /valheim/mods/packages --query Parameter.Value --output text > /opt/valheim/mods.json.tmp
mv /opt/valheim/mods.json.tmp /opt/valheim/mods.json
aws ssm get-parameters-by-path --region "$REGION" --path /valheim/mods/config/ --query 'Parameters[].[Name,Value]' --output json > /opt/valheim/mods-config.json.tmp
mv /opt/valheim/mods-config.json.tmp /opt/valheim/mods-config.json
mkdir -p /opt/valheim/config /opt/valheim/data
chown 1000:1000 /opt/valheim/config /opt/valheim/data
/usr/local/bin/valheim-mods sync /opt/valheim/mods.json /opt/valheim/mods-config.json --config-root /opt/valheim/config/bepinex --install-root /opt/valheim/data/bepinex/BepInEx --cache /opt/valheim/mods-cache
mkdir -p /opt/valheim/worlds/rpgworld/config /opt/valheim/worlds/rpgworld/data
chown 1000:1000 /opt/valheim/worlds/rpgworld/config /opt/valheim/worlds/rpgworld/data
/usr/local/bin/valheim-mods sync /opt/valheim/mods.json /opt/valheim/mods-config.json --config-root /opt/valheim/worlds/rpgworld/config/bepinex --install-root /opt/valheim/worlds/rpgworld/data/bepinex/BepInEx --cache /opt/valheim/mods-cache
EOF
chmod 0755 /usr/local/bin/valheim-fetch-config
aws s3 cp s3://cdk-hnb659fds-assets-623096509435-us-east-1/606ad3172fd0bcc72f3085f9e8d95cf890c8da05114b1490a1e6c1fd55a9b7eb.py /usr/local/bin/valheim-mods --region us-east-1
chmod 0755 /usr/local/bin/valheim-mods
aws s3 cp s3://cdk-hnb659fds-assets-623096509435-us-east-1/4774e1865594a19ea72b2b173b21078535de83da7c1b231306735409757b6e0b.py /usr/local/bin/valheim-players --region us-east-1
chmod 0755 /usr/local/bin/valheim-players
cat > /etc/systemd/system/valheim-players.service <<'EOF'
[Unit]
Description=Publish who is online in Valheim (valheim) to SSM
Requires=docker.service
After=docker.service valheim.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/valheim-players /valheim/panel/players us-east-1 valheim
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

EOF
cat > /etc/systemd/system/valheim-players-rpgworld.service <<'EOF'
[Unit]
Description=Publish who is online in Valheim (valheim-rpgworld) to SSM
Requires=docker.service
After=docker.service valheim.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/valheim-players /valheim/panel/players-rpgworld us-east-1 valheim-rpgworld
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

EOF
systemctl daemon-reload
systemctl enable --now valheim-players.service
systemctl restart valheim-players.service
systemctl enable --now valheim-players-rpgworld.service
systemctl restart valheim-players-rpgworld.service

cat > /etc/systemd/system/valheim.service <<'EOF'
[Unit]
Description=Valheim dedicated server (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/valheim
ExecStartPre=/usr/local/bin/valheim-fetch-config
ExecStart=/usr/bin/docker compose -f /opt/valheim/compose.yaml up -d
ExecStop=/usr/bin/docker compose -f /opt/valheim/compose.yaml stop -t 120
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now valheim.service
