{
  "name": "valheim-server",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "synth": "cdk synth",
    "diff": "cdk diff --profile ${AWS_PROFILE:-valheim}",
    "deploy": "cdk deploy --profile ${AWS_PROFILE:-valheim} --require-approval never",
    "bootstrap": "cdk bootstrap aws://623096509435/us-east-1 --profile ${AWS_PROFILE:-valheim}",
    "server": "bash scripts/server.sh",
    "install-scripts": "tsx scripts/install-scripts.ts",
    "share-profile": "tsx scripts/share-profile.ts",
    "check-mods": "tsx scripts/check-mods.ts",
    "cdk": "cdk"
  },
  "devDependencies": {
    "@aws-sdk/client-ec2": "^3.1135.0",
    "@aws-sdk/client-scheduler": "^3.1135.0",
    "@aws-sdk/client-secrets-manager": "^3.1135.0",
    "@aws-sdk/client-ssm": "^3.1135.0",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/aws-lambda": "^8.10.163",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1142.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jest": "^30",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.269.0",
    "constructs": "^10.5.0",
    "yaml": "^2.9.1"
  }
}
